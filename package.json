{
  "name": "steamnext",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "update:top250": "node scripts/update-top250.mjs",
    "update:activity": "node scripts/update-activity.mjs",
    "build": "node scripts/build.mjs",
    "build:cloudflare": "node scripts/build.mjs --cloudflare-only",
    "deploy": "node scripts/deploy.mjs",
    "upload:version": "cf workers versions create --prebuilt",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.cjs",
    "test:worker": "node scripts/worker-check.mjs"
  },
  "dependencies": {
    "@rimelight/i18n": "0.1.22",
    "@rimelight/ui": "0.0.97",
    "@solidjs/router": "2.0.0-next.44",
    "@solidjs/web": "2.0.0-rc.21",
    "solid-js": "2.0.0-rc.21"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.11",
    "@iconify-json/lucide": "1.2.151",
    "@rimelight/config": "0.0.48",
    "@solidjs/vite-plugin": "3.0.0-next.56",
    "@types/node": "^26.6.6",
    "cf": "1.0.0-beta.27",
    "filesystem-routing": "0.4.2",
    "typescript": "7.1.0-beta",
    "unocss": "66.12.0",
    "vite-plus": "1.5.0"
  },
  "packageManager": "pnpm@12.16.1"
}
